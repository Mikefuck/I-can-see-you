<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_device_row"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
    <TextView android:id="@+id/widget_device_owner" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="9sp" android:textColor="@color/widget_muted" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="18dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_device_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_device_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:textColor="@color/widget_ink"
            android:layout_marginStart="6dp" android:includeFontPadding="false" />
    </LinearLayout>
    <ImageView android:id="@+id/widget_device_bar" android:layout_width="match_parent" android:layout_height="12dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <TextView android:id="@+id/widget_device_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="16dp"
        android:textSize="10sp" android:textColor="@color/widget_muted" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
</LinearLayout>
