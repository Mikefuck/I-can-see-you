# 复制为 .env，与 compose.yaml 放在同一目录。
# 用户名默认 admin；自定义时限 3–40 位英文字母、数字、_ . -，不能使用中文或空格。
ADMIN_USERNAME=admin
# 必须自行填写 12–256 个字符的密码；建议用英文单引号包住，避免 $ 被解释为变量。
# 修改后重新创建容器会同步管理员密码；从旧版升级到 r4 时也会同步一次。
ADMIN_PASSWORD=
# The offline release imports this image tag with docker load.
FOCUSLEDGER_IMAGE=focusledger-server:2026.10.16-r10
# 固定的外部数据卷名；新装先执行 docker volume create focusledger-data。
# 已有服务必须改成原容器 /data 的实际卷名（如 server_focus-data），不要创建空卷替代旧卷。
FOCUSLEDGER_DATA_VOLUME=focusledger-data
SERVER_PORT=8080
BIND_HOST=0.0.0.0
RETENTION_DAYS=365
# Set true when serving the website through an HTTPS reverse proxy.
SECURE_COOKIES=false
