ADMIN_USERNAME=admin
# Replace before first startup. Password must contain at least 12 characters.
ADMIN_PASSWORD=
# The offline release imports this image tag with docker load.
FOCUSLEDGER_IMAGE=focusledger-server:2026.10.15-r3
SERVER_PORT=8080
BIND_HOST=0.0.0.0
RETENTION_DAYS=365
# Set true when serving the website through an HTTPS reverse proxy.
SECURE_COOKIES=false
